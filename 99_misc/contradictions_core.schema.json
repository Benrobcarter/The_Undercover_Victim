{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "contradictions"
  ],
  "properties": {
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "folder_id",
          "title",
          "claim",
          "reality",
          "actors",
          "laws",
          "damages"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "folder_id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "reality": {
            "type": "string"
          },
          "date_of_claim": {
            "type": "string"
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "laws": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "damages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}