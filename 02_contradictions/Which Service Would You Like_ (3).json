ak_holder] -->html {<!-- [et_pb_line_break_holder] -->  scroll-behavior: smooth;<!-- [et_pb_line_break_holder] -->}<!-- [et_pb_line_break_holder] --><\/style>[\/et_pb_code][\/et_pb_column][\/et_pb_row][et_pb_row _builder_version=\"4.27.4\" _module_preset=\"default\" global_colors_info=\"{}\" theme_builder_area=\"et_footer_layout\"][et_pb_column type=\"4_4\" _builder_version=\"4.27.4\" _module_preset=\"default\" global_colors_info=\"{}\" theme_builder_area=\"et_footer_layout\"][et_pb_text _builder_version=\"4.27.4\" _module_preset=\"default\" text_text_color=\"#F7F9FC\" width=\"100%\" max_width=\"100%\" module_alignment=\"left\" global_colors_info=\"{}\" theme_builder_area=\"et_footer_layout\"]<p>email no.reply@policeplease.com<\/p>[\/et_pb_text][\/et_pb_column][\/et_pb_row][et_pb_row _builder_version=\"4.27.4\" _module_preset=\"default\" global_colors_info=\"{}\" theme_builder_area=\"et_footer_layout\"][et_pb_column type=\"4_4\" _builder_version=\"4.27.4\" _module_preset=\"default\" global_colors_info=\"{}\" theme_builder_area=\"et_footer_layout\"][et_pb_code _builder_version=\"4.27.4\" _module_preset=\"default\" global_colors_info=\"{}\" theme_builder_area=\"et_footer_layout\"]<script src=\"https:\/\/unpkg.com\/wavesurfer.js\"><\/script><!-- [et_pb_line_break_holder] --><script><!-- [et_pb_line_break_holder] -->document.addEventListener(\"DOMContentLoaded\", function () {<!-- [et_pb_line_break_holder] -->  const players = document.querySelectorAll(\".waveform-container\");<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->  players.forEach((container, index) => {<!-- [et_pb_line_break_holder] -->    const waveId = \"waveform-\" + index;<!-- [et_pb_line_break_holder] -->    container.querySelector(\".waveform\").id = waveId;<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->    const audioUrl = container.dataset.audio;<!-- [et_pb_line_break_holder] -->    const wavesurfer = WaveSurfer.create({<!-- [et_pb_line_break_holder] -->      container: \"#\" + waveId,<!-- [et_pb_line_break_holder] -->      waveColor: \"#ff0070\",<!-- [et_pb_line_break_holder] -->      progressColor: \"#00ffe7\",<!-- [et_pb_line_break_holder] -->      height: 100,<!-- [et_pb_line_break_holder] -->      barWidth: 2,<!-- [et_pb_line_break_holder] -->      responsive: true,<!-- [et_pb_line_break_holder] -->      normalize: true,<!-- [et_pb_line_break_holder] -->    });<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->    let loaded = false;<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->    const observer = new IntersectionObserver(<!-- [et_pb_line_break_holder] -->      (entries) => {<!-- [et_pb_line_break_holder] -->        entries.forEach((entry) => {<!-- [et_pb_line_break_holder] -->          if (entry.isIntersecting && !loaded) {<!-- [et_pb_line_break_holder] -->            wavesurfer.load(audioUrl);<!-- [et_pb_line_break_holder] -->            loaded = true;<!-- [et_pb_line_break_holder] -->          }<!-- [et_pb_line_break_holder] -->        });<!-- [et_pb_line_break_holder] -->      },<!-- [et_pb_line_break_holder] -->      { threshold: 0.3 }<!-- [et_pb_line_break_holder] -->    );<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->    observer.observe(container);<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->    const playBtn = container.querySelector(\".play\");<!-- [et_pb_line_break_holder] -->    const pauseBtn = container.querySelector(\".pause\");<!-- [et_pb_line_break_holder] --><!-- [et_pb_line_break_holder] -->    playBtn.addEventListener(\"click\", () => wavesurfer.play());<!-- [et_pb_line_break_holder] -->    pauseBtn.addEventListener(\"click\", () => wavesurfer.pause());<!-- [et_pb_line_break_holder] -->  });<!-- [et_pb_line_break_holder] -->});<!-- [et_pb_line_break_holder] --><\/script><!-- [et_pb_line_break_holder] -->[\/et_pb_code][\/et_pb_column][\/et_pb_row][\/et_pb_section]"},"presets":{},"global_colors":[["gcid-primary-color",{"color":"#05000f","active":"yes"}],["gcid-secondary-color",{"color":"#001035","active":"yes"}],["gcid-heading-color",{"color":"#666666","active":"yes"}],["gcid-body-color",{"color":"#666666","active":"yes"}]],"images":[],"thumbnails":[]}